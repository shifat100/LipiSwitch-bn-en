{
  "manifest_version": 3,
  "name": "LipiSwitch – Script Transliteration",
  "short_name": "LipiSwitch",
  "version": "1.0.0",
"icons": {
"16":"/icons/16.png",
"48":"/icons/48.png",
"128":"/icons/128.png"
},
  "description": "Seamless real-time script transliteration between Bengali and Devanagari across any website.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LipiSwitch Controls"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}